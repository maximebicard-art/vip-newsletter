# VIP & Industry Newsletter - Environment Configuration
# Copy this to .env and fill in your values

# ============================================
# RECIPIENT (Your Tutanota Email)
# ============================================
NEWSLETTER_RECIPIENT=your-email@tutanota.com

# ============================================
# SENDER INFO
# ============================================
FROM_NAME=VIP & Industry News
FROM_EMAIL=newsletter@yourdomain.com
SENDER_NAME=Your Name
SENDER_TITLE=Junior Publicist, VIP & Media Relations
COMPANY_NAME=Your Company
COMPANY_ADDRESS=Your Address<br>City, State ZIP
SENDER_EMAIL=you@company.com
SENDER_PHONE=(555) 000-0000
COMPANY_URL=https://company.com
CALENDAR_LINK=https://company.com/calendar

# ============================================
# EMAIL SENDING PROVIDER
# Choose one: brevo, mailjet, sendgrid, smtp
# ============================================
EMAIL_PROVIDER=brevo

# Brevo (Recommended - 300/day free, EU/GDPR)
# Get key: https://www.brevo.com/ → SMTP & API → API Keys
BREVO_API_KEY=your-brevo-api-key-here

# Mailjet (6,000/month free)
# Get keys: https://www.mailjet.com/ → Account → API Key Management
MAILJET_API_KEY=your-mailjet-api-key
MAILJET_API_SECRET=your-mailjet-api-secret

# SendGrid (100/day for 60 days)
# Get key: https://app.sendgrid.com/ → Settings → API Keys
SENDGRID_API_KEY=SG.your-sendgrid-key

# SMTP (Gmail, Outlook, etc.)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ============================================
# AUTOMATION
# Set to 1 to actually send emails. 0 = generate only.
SEND_EMAIL=0
